# ==============================================================================
# HỆ THỐNG QUẢN LÝ CHẤM CÔNG & PHÂN TÍCH NHÂN SỰ - BIẾN MÔI TRƯỜNG BACKEND
# Tạo file .env trong thư mục backend/ và sao chép nội dung bên dưới
# ==============================================================================

# Cổng khởi chạy máy chủ Express
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# KẾT NỐI CƠ SỞ DỮ LIỆU (SUPABASE HOẶC POSTGRESQL NỘI BỘ)
# ------------------------------------------------------------------------------
# Chế độ Transaction Pooler (PGBouncer) cho các truy vấn ứng dụng
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Chế độ Session Direct Connection (Bắt buộc cho Prisma migrations & seeding)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Nếu chạy PostgreSQL trên máy cá nhân (Localhost), dùng:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_db?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/attendance_db?schema=public"

# ------------------------------------------------------------------------------
# BẢO MẬT JSON WEB TOKEN (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=attendance-system-jwt-secret-key-2024-super-secure-change-me
JWT_REFRESH_SECRET=attendance-system-refresh-secret-key-2024-super-secure-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CẤU HÌNH GIAO DIỆN & BẢO VỆ MÁY CHỦ (CORS & RATE LIMITING)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
